<Window x:Class="FNFAssetPrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FNF Asset Prep"
        Width="1080"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#F3F3F3"
        FontFamily="Segoe UI"
        FontSize="13">

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Add files..." InputGestureText="Ctrl+O" Click="AddFiles_Click"/>
                <MenuItem Header="Choose _output folder..." InputGestureText="Ctrl+Shift+O" Click="ChooseOutput_Click"/>
                <MenuItem Header="Open output _folder" Click="OpenOutput_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Remove selected" InputGestureText="Delete" Click="RemoveSelected_Click"/>
                <MenuItem Header="_Clear list" InputGestureText="Ctrl+L" Click="Clear_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About FNF Asset Prep" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Add files" Click="AddFiles_Click" Padding="10,3"/>
                <Button Content="Remove" Click="RemoveSelected_Click" Padding="10,3"/>
                <Button Content="Clear" Click="Clear_Click" Padding="10,3"/>
                <Separator/>
                <Button Content="Choose output folder" Click="ChooseOutput_Click" Padding="10,3"/>
                <Separator/>
                <TextBlock Text="Tip: You can drag files into this window." VerticalAlignment="Center" Foreground="#666666"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="FileCountStatus" Text="0 files"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="AudioEngineStatus" Text="Audio engine: checking"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Files">
                <Grid>
                    <DataGrid x:Name="AssetGrid"
                              ItemsSource="{Binding Assets}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                            <DataGridTextColumn Header="From" Binding="{Binding SourceFormat}" Width="80"/>
                            <DataGridTextColumn Header="To" Binding="{Binding TargetFormat}" Width="70"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="115"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="EmptyHint"
                            Background="#FAFAFA"
                            BorderBrush="#D8D8D8"
                            BorderThickness="1"
                            Margin="18"
                            CornerRadius="3"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Drop image or audio files here"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="or use File > Add files"
                                       Margin="0,6,0,0"
                                       Foreground="#666666"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="PNG, JPG, JPEG, WebP, BMP, TIFF, OGG, WAV, MP3, FLAC, M4A, AAC"
                                       Margin="0,14,0,0"
                                       Foreground="#777777"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Column="2">
                <GroupBox Header="Output" Margin="0,0,0,10">
                    <StackPanel Margin="8">
                        <TextBlock Text="Folder" Margin="0,0,0,5"/>
                        <TextBox x:Name="OutputFolderText"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MinHeight="48"
                                 Padding="6"
                                 VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Browse..." Click="ChooseOutput_Click" Padding="12,4"/>
                            <Button Content="Open folder" Click="OpenOutput_Click" Padding="12,4" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Audio" Margin="0,0,0,10">
                    <StackPanel Margin="8">
                        <TextBlock Text="OGG Vorbis quality"/>
                        <ComboBox x:Name="QualityCombo" SelectedIndex="3" Margin="0,6,0,0">
                            <ComboBoxItem Content="3 - Smaller file"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6 - Balanced"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8 - Higher quality"/>
                        </ComboBox>
                        <TextBlock Text="PNG and OGG files are copied. Other supported files are converted."
                                   TextWrapping="Wrap"
                                   Foreground="#666666"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Summary" Margin="0,0,0,10">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Images"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ImageCountText" Text="0" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1" Text="Audio" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AudioCountText" Text="0" FontWeight="SemiBold" Margin="0,6,0,0"/>

                        <TextBlock Grid.Row="2" Text="Total" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TotalCountText" Text="0" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </Grid>
                </GroupBox>

                <Button x:Name="PrepButton"
                        Content="Prep files"
                        Click="PrepFiles_Click"
                        Height="42"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        IsEnabled="False"/>

                <ProgressBar x:Name="ProgressBar"
                             Minimum="0"
                             Maximum="1"
                             Value="0"
                             Height="16"
                             Margin="0,10,0,0"/>

                <TextBlock x:Name="ProgressText"
                           Text=""
                           Foreground="#555555"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
