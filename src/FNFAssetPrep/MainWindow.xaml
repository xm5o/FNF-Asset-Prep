<Window x:Class="FNFAssetPrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FNF Asset Prep"
        Width="1120"
        Height="760"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Add files..." InputGestureText="Ctrl+O" Click="MenuAddFiles_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Asset Prep" Click="MenuAssetPrep_Click"/>
                <MenuItem Header="Audio _Converter" Click="MenuConverter_Click"/>
                <MenuItem Header="_YouTube Audio" Click="MenuYouTube_Click"/>
                <MenuItem Header="_Settings" Click="MenuSettings_Click"/>
                <MenuItem Header="_About" Click="MenuAbout_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About FNF Asset Prep" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="GlobalStatusText" Text="Ready"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ToolStatusText" Text="Checking tools..."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ThemeStatusText" Text="Theme"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Background="{DynamicResource AppBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,18,16,12">
                        <TextBlock Text="FNF Asset Prep"
                                   FontSize="19"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Desktop toolbox"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="NavigationList"
                             Margin="8,4,8,8"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="NavigationList_SelectionChanged">
                        <ListBoxItem Tag="assets" Padding="12,10">Asset Prep</ListBoxItem>
                        <ListBoxItem Tag="converter" Padding="12,10">Audio Converter</ListBoxItem>
                        <ListBoxItem Tag="youtube" Padding="12,10">YouTube Audio</ListBoxItem>
                        <ListBoxItem Tag="settings" Padding="12,10" Margin="0,10,0,0">Settings</ListBoxItem>
                        <ListBoxItem Tag="about" Padding="12,10">About</ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1"
                            x:Name="PageHost"
                            Background="{DynamicResource AppBackgroundBrush}"/>
        </Grid>
    </DockPanel>
</Window>
