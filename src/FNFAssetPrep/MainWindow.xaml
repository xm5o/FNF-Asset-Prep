<Window x:Class="FNFAssetPrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FNF Asset Prep"
        Width="1120"
        Height="760"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        FontFamily="Segoe UI"
        FontSize="13">

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Add files..." InputGestureText="Ctrl+O" Click="MenuAddFiles_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Asset Prep" Click="MenuAssetPrep_Click"/>
                <MenuItem Header="_YouTube Audio" Click="MenuYouTube_Click"/>
                <MenuItem Header="_Settings" Click="MenuSettings_Click"/>
                <MenuItem Header="_About" Click="MenuAbout_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About FNF Asset Prep" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="GlobalStatusText" Text="Ready"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ToolStatusText" Text="Checking tools..."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Native test build"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F8F8F8"
                    BorderBrush="#D8D8D8"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,18,16,10">
                        <TextBlock Text="FNF Asset Prep"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Desktop toolbox"
                                   Foreground="#666666"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="NavigationList"
                             Margin="8,4,8,8"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="NavigationList_SelectionChanged">
                        <ListBoxItem Tag="assets" Padding="12,9">Asset Prep</ListBoxItem>
                        <ListBoxItem Tag="youtube" Padding="12,9">YouTube Audio</ListBoxItem>
                        <ListBoxItem Tag="settings" Padding="12,9">Settings</ListBoxItem>
                        <ListBoxItem Tag="about" Padding="12,9">About</ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1"
                            x:Name="PageHost"/>
        </Grid>
    </DockPanel>
</Window>
