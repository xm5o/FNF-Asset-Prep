<UserControl x:Class="FNFAssetPrep.Views.AssetPrepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             Drop="View_Drop"
             DragOver="View_DragOver"
             PreviewKeyDown="View_PreviewKeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Asset Prep" FontSize="27" FontWeight="SemiBold"/>
                <TextBlock Text="Prepare images as PNG and audio as OGG for FNF."
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Add files" Click="AddFiles_Click" Padding="14,5"/>
                <Button Content="Remove" Click="RemoveSelected_Click" Margin="6,0,0,0" Padding="14,5"/>
                <Button Content="Clear" Click="Clear_Click" Margin="6,0,0,0" Padding="14,5"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Border x:Name="EmptyState"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
                    <TextBlock Text="Drop image or audio files here"
                               FontSize="19"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="or press Add files"
                               Margin="0,7,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="PNG, JPG, WebP, BMP, TIFF, OGG, WAV, MP3, FLAC, M4A, AAC"
                               Margin="0,16,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="560"/>
                </StackPanel>
            </Border>

            <Border x:Name="FileTablePanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="1">
                <DataGrid x:Name="AssetGrid"
                          ItemsSource="{Binding Assets}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding FileName}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                        <DataGridTextColumn Header="From" Binding="{Binding SourceFormat}" Width="80"/>
                        <DataGridTextColumn Header="To" Binding="{Binding TargetFormat}" Width="70"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Output folder" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBox x:Name="OutputFolderText"
                             IsReadOnly="True"
                             Margin="0,5,0,0"
                             Padding="7,5"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="OGG quality" Foreground="{DynamicResource MutedTextBrush}"/>
                    <ComboBox x:Name="QualityCombo" Margin="0,5,0,0">
                        <ComboBoxItem Content="3 - Smaller" Tag="3"/>
                        <ComboBoxItem Content="4" Tag="4"/>
                        <ComboBoxItem Content="5" Tag="5"/>
                        <ComboBoxItem Content="6 - Balanced" Tag="6"/>
                        <ComboBoxItem Content="7" Tag="7"/>
                        <ComboBoxItem Content="8 - Higher" Tag="8"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Browse..." Click="ChooseOutput_Click"/>
                    <Button Content="Open" Click="OpenOutput_Click" Margin="6,0,0,0"/>
                    <Button x:Name="PrepButton"
                            Content="Prep files"
                            Click="PrepFiles_Click"
                            Margin="10,0,0,0"
                            Padding="18,5"
                            FontWeight="SemiBold"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" VerticalAlignment="Bottom" Margin="0,82,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="1" Value="0" Height="8"/>
            <TextBlock x:Name="ProgressText"
                       Grid.Column="1"
                       Margin="12,-6,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </Grid>
    </Grid>
</UserControl>
