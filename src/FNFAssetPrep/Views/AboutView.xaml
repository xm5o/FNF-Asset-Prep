<UserControl x:Class="FNFAssetPrep.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="About" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="FNF Asset Prep" FontSize="20" FontWeight="SemiBold" Margin="0,22,0,0"/>
            <TextBlock Text="Native Windows development build"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,0"/>
            <TextBlock Text="A desktop toolbox for preparing FNF assets, converting local audio, and saving permitted YouTube audio."
                       TextWrapping="Wrap"
                       Margin="0,14,0,0"/>

            <GroupBox Header="This build" Margin="0,18,0,0">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="UI"/><TextBlock Grid.Column="1" Text="C# and WPF"/>
                    <TextBlock Grid.Row="1" Text="Runtime" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RuntimeText" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Text="Theme" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ThemeText" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="3" Text="FFmpeg" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="FfmpegText" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="4" Text="yt-dlp" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="YtDlpText" Margin="0,6,0,0"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Privacy" Margin="0,12,0,0">
                <StackPanel Margin="10">
                    <TextBlock Text="Local conversion works with files on your PC only." TextWrapping="Wrap"/>
                    <TextBlock Text="Settings are stored locally in your AppData folder."
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="The YouTube Audio page connects to YouTube only when you check or download a link."
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <TextBlock Text="Only download videos you own or have permission to save."
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
