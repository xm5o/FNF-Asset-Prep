<UserControl x:Class="FNFAssetPrep.Views.YouTubeAudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="YouTube Audio"
                           FontSize="26"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Save audio from a YouTube video you own or have permission to download."
                           Foreground="#666666"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <GroupBox Grid.Row="2" Header="Video">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="UrlTextBox"
                             Grid.Row="0"
                             Grid.Column="0"
                             MinHeight="34"
                             Padding="8,5"
                             VerticalContentAlignment="Center"
                             ToolTip="Paste a YouTube video URL"/>

                    <Button x:Name="CheckLinkButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="Check link"
                            Click="CheckLink_Click"
                            Padding="14,5"
                            Margin="8,0,0,0"/>

                    <Border Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Background="#FAFAFA"
                            BorderBrush="#D8D8D8"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="VideoTitleText"
                                           Text="Paste a link, then press Check link."
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="VideoChannelText"
                                           Text=""
                                           Foreground="#666666"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <TextBlock x:Name="VideoDurationText"
                                       Grid.Column="1"
                                       Text=""
                                       Foreground="#666666"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </GroupBox>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Download">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Format"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <ComboBox x:Name="FormatCombo"
                                      Grid.Column="1"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="OGG"/>
                                <ComboBoxItem Content="MP3"/>
                                <ComboBoxItem Content="WAV"/>
                                <ComboBoxItem Content="FLAC"/>
                                <ComboBoxItem Content="M4A"/>
                                <ComboBoxItem Content="OPUS"/>
                                <ComboBoxItem Content="AAC"/>
                                <ComboBoxItem Content="ALAC"/>
                            </ComboBox>

                            <TextBox x:Name="DownloadFolderText"
                                     Grid.Column="3"
                                     IsReadOnly="True"
                                     Padding="7,5"
                                     VerticalContentAlignment="Center"/>

                            <Button Grid.Column="4"
                                    Content="Browse..."
                                    Click="ChooseDownloadFolder_Click"
                                    Padding="12,4"
                                    Margin="8,0,0,0"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="DownloadButton"
                                    Content="Download audio"
                                    Click="Download_Click"
                                    Height="38"
                                    Padding="16,5"
                                    FontWeight="SemiBold"/>

                            <Button x:Name="CancelButton"
                                    Content="Cancel"
                                    Click="Cancel_Click"
                                    Height="38"
                                    Padding="16,5"
                                    Margin="8,0,0,0"
                                    IsEnabled="False"/>

                            <Button Content="Open folder"
                                    Click="OpenDownloadFolder_Click"
                                    Height="38"
                                    Padding="16,5"
                                    Margin="8,0,0,0"/>
                        </StackPanel>

                        <ProgressBar x:Name="DownloadProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Height="16"
                                     Margin="0,12,0,0"/>

                        <TextBlock x:Name="DownloadStatusText"
                                   Text="Ready"
                                   Foreground="#555555"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="2" Header="Tools">
                    <StackPanel Margin="10">
                        <TextBlock x:Name="DownloaderStatusText"
                                   Text="yt-dlp: checking"/>
                        <TextBlock x:Name="FfmpegStatusText"
                                   Text="FFmpeg: checking"
                                   Margin="0,6,0,0"/>
                        <Separator Margin="0,10"/>
                        <TextBlock Text="Single videos only"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Playlists are skipped in this build."
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <GroupBox Grid.Row="6" Header="Activity">
                <TextBox x:Name="ActivityTextBox"
                         Margin="8"
                         MinHeight="120"
                         MaxHeight="210"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"/>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl>
