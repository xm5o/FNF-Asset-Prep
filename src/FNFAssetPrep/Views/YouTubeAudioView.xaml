<UserControl x:Class="FNFAssetPrep.Views.YouTubeAudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <TextBlock Text="YouTube Audio" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="Save audio from a YouTube video you own or have permission to download."
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,16"/>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
                <StackPanel>
                    <TextBlock Text="Video link" FontWeight="SemiBold"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UrlTextBox" MinHeight="34" Padding="8,5"/>
                        <Button x:Name="CheckLinkButton"
                                Grid.Column="1"
                                Content="Check link"
                                Click="CheckLink_Click"
                                Margin="8,0,0,0"
                                Padding="14,5"/>
                    </Grid>

                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="VideoTitleText"
                                           Text="Paste a link, then press Check link."
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="VideoChannelText"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="VideoDurationText"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Download options" FontWeight="SemiBold"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Format" Foreground="{DynamicResource MutedTextBrush}"/>
                            <ComboBox x:Name="FormatCombo" Margin="0,5,0,0">
                                <ComboBoxItem Content="OGG"/><ComboBoxItem Content="MP3"/><ComboBoxItem Content="WAV"/>
                                <ComboBoxItem Content="FLAC"/><ComboBoxItem Content="M4A"/><ComboBoxItem Content="OPUS"/>
                                <ComboBoxItem Content="AAC"/><ComboBoxItem Content="ALAC"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quality" Foreground="{DynamicResource MutedTextBrush}"/>
                            <ComboBox x:Name="QualityCombo" Margin="0,5,0,0">
                                <ComboBoxItem Content="Best"/><ComboBoxItem Content="High"/>
                                <ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Small"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="File name" Foreground="{DynamicResource MutedTextBrush}"/>
                            <ComboBox x:Name="FileNameCombo" Margin="0,5,0,0">
                                <ComboBoxItem Content="Title"/><ComboBoxItem Content="Title [ID]"/>
                                <ComboBoxItem Content="Channel - Title"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Output folder" Foreground="{DynamicResource MutedTextBrush}"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DownloadFolderText" IsReadOnly="True" Padding="7,5"/>
                                <Button Grid.Column="1" Content="Browse..." Click="ChooseDownloadFolder_Click" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox x:Name="MetadataCheckBox" Content="Embed metadata"/>
                        <CheckBox x:Name="ThumbnailCheckBox" Content="Embed thumbnail" Margin="18,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="DownloadButton"
                                Content="Download audio"
                                Click="Download_Click"
                                Padding="18,6"
                                FontWeight="SemiBold"/>
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Click="Cancel_Click"
                                Margin="8,0,0,0"
                                IsEnabled="False"/>
                        <Button Content="Open folder"
                                Click="OpenDownloadFolder_Click"
                                Margin="8,0,0,0"/>
                    </StackPanel>

                    <ProgressBar x:Name="DownloadProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="8"
                                 Margin="0,14,0,0"/>
                    <TextBlock x:Name="DownloadStatusText"
                               Text="Ready"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <GroupBox Header="Activity">
                    <TextBox x:Name="ActivityTextBox"
                             Margin="8"
                             MinHeight="130"
                             MaxHeight="190"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"/>
                </GroupBox>

                <GroupBox Grid.Column="2" Header="Tools">
                    <StackPanel Margin="10">
                        <TextBlock x:Name="DownloaderStatusText"/>
                        <TextBlock x:Name="FfmpegStatusText" Margin="0,6,0,0"/>
                        <TextBlock Text="Single videos only. Playlists are skipped."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
