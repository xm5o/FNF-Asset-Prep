{
  "name": "fnf-asset-prep",
  "version": "0.1.0",
  "description": "A small desktop utility that prepares images and audio for Friday Night Funkin' mods.",
  "main": "src/main.js",
  "author": "xm5o",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis portable",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "io.xm5o.fnfassetprep",
    "productName": "FNF Asset Prep",
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "FNF-Asset-Prep-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "FNF-Asset-Prep-Portable-${version}-${arch}.${ext}"
    }
  }
}
